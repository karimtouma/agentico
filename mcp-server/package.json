{
  "name": "agentico-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "check": "npm run typecheck && wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "prepare-content": "tsx scripts/prepare-content.ts",
    "upload-kv": "wrangler kv bulk put kv-data.json --binding=BOOK_KV --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "agents": "^0.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.65.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
